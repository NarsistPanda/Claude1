# AG-UI Bridge Server Configuration

# Port to run the server on
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# =============================================================================
# n8n Multi-Agent Orchestration Configuration
# =============================================================================

# Main orchestrator webhook URL (multi-agent-react workflow)
# This is the primary endpoint that handles ReAct orchestration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/multi-agent-chat

# =============================================================================
# Tool Agent Workflow IDs (used by the Manager Agent)
# These are the workflow IDs for agent-as-a-tool patterns
# =============================================================================

# Browser automation agent with Playwright MCP
BROWSER_AGENT_WORKFLOW_ID=

# Python code interpreter agent
CODE_AGENT_WORKFLOW_ID=

# Web search agent (SerpAPI, Wikipedia)
SEARCH_AGENT_WORKFLOW_ID=

# Deep research agent (multi-source synthesis)
RESEARCH_AGENT_WORKFLOW_ID=

# RAG search agent (Qdrant vector store)
RAG_AGENT_WORKFLOW_ID=

# =============================================================================
# Memory System Configuration
# =============================================================================

# Qdrant Vector Database for long-term memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis for session management (optional)
REDIS_URL=redis://localhost:6379

# =============================================================================
# External Services
# =============================================================================

# Playwright MCP server URL for browser automation
PLAYWRIGHT_MCP_URL=http://localhost:3002

# =============================================================================
# Optional: Define multiple n8n agents as JSON array
# =============================================================================
# N8N_AGENTS=[
#   {"id":"orchestrator","name":"Multi-Agent Orchestrator","url":"https://n8n.example.com/webhook/multi-agent-chat"},
#   {"id":"simple","name":"Simple Chat Agent","url":"https://n8n.example.com/webhook/simple-chat"}
# ]
