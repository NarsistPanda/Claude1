# AG-UI Bridge Server Configuration

# Port to run the server on
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# n8n Webhook URL for your AI Agent workflow
# This is the webhook URL from your n8n workflow that uses the AI Agent node
# Example: https://your-n8n-instance.com/webhook/xxxxx-xxxx-xxxx-xxxx
N8N_WEBHOOK_URL=

# Optional: Define multiple n8n agents as JSON array
# N8N_AGENTS=[{"id":"agent1","name":"Research Agent","url":"https://n8n.example.com/webhook/agent1"},{"id":"agent2","name":"Code Agent","url":"https://n8n.example.com/webhook/agent2"}]
